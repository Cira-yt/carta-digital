# =============================================================================
# Carta Digital — configuración del despliegue automático.
#
#   cp scripts/deploy/deploy.env.example scripts/deploy/deploy.env
#   (completá los valores marcados con  <-- COMPLETAR)
#
# deploy.env está en .gitignore: NUNCA lo subas al repo, tiene contraseñas.
#
# OJO: las credenciales de AWS (Access Key / Secret / Session Token) NO van
# acá. Se configuran aparte, con "aws configure" o usando AWS CloudShell
# (ver docs/despliegue-automatico.md, sección "Credenciales").
# =============================================================================

# ------------------------------------------------------------- AWS general
AWS_REGION=us-east-1
# carta-v2 = instalación NUEVA y separada de la anterior (carta-digital-*),
# que queda intacta. Si algún día querés actualizar la anterior, poné carta-digital.
NAME_PREFIX=carta-v2               # prefijo de todos los recursos que crea el script

# Opcionales: si los dejás vacíos el script los detecta solo.
VPC_ID=                            # vacío = VPC por defecto de la cuenta
AMI_ID=                            # vacío = última Amazon Linux 2023 (x86_64)
INSTANCE_TYPE=t3.micro
KEY_NAME=                          # nombre del key pair EC2 para entrar por SSH (ej. vockey en AWS Academy). Vacío = sin SSH
EXISTING_INSTANCE_ID=              # opcional: una EC2 que ya sirve la app y querés sumar al Load Balancer

# El ALB solo acepta tráfico 80/443 desde los rangos de IP de Cloudflare
# (así nadie se salta el Worker pegándole directo al ALB). Poné 0 solo para
# depurar el ALB directo; dejalo en 1 (o vacío) en condiciones normales.
RESTRINGIR_A_CLOUDFLARE=1

# ------------------------------------------------------------- Auto Scaling
ASG_MIN=1
ASG_DESIRED=2
ASG_MAX=4
CPU_TARGET=50                      # % de CPU promedio que dispara el escalado

# ------------------------------------------------------------- Código (Git)
# El script NO sube tu código: cada instancia lo clona de esta rama.
# Hacé push de la rama nueva ANTES de desplegar.
GITHUB_REPO=https://github.com/Cira-yt/carta-digital.git
GITHUB_BRANCH=entrega-final
# Opcional: solo si algún día el repo vuelve a ser PRIVADO. Token de solo lectura:
# GitHub → Settings → Developer settings → Fine-grained tokens → repo carta-digital,
# permiso Contents → Read-only.
GITHUB_TOKEN=                      # vacío = repo público (caso actual)

# ------------------------------------------------------------- RDS (PostgreSQL)
RDS_INSTANCE_ID=carta-v2-db         # base nueva (la anterior, carta-digital-db, no se toca)
RDS_ENGINE_VERSION=17
RDS_INSTANCE_CLASS=db.t3.micro
RDS_STORAGE_GB=20
RDS_MULTI_AZ=false
RDS_MASTER_USER=carta_admin
RDS_MASTER_PASSWORD=               # <-- COMPLETAR (mín. 8 caracteres; usá solo letras y números)

# Usuario/base que usa la app (el script los crea dentro de RDS).
DB_NAME=carta_digital
DB_USER=carta_app
DB_PASSWORD=                       # <-- COMPLETAR (distinta a la maestra; solo letras y números)

# ------------------------------------------------------------- App
SESSION_SECRET=                    # <-- COMPLETAR (generala con: openssl rand -hex 32)
SESSION_SECURE_COOKIE=false

# ------------------------------------------------------------- Cloudflare
# Si tenés dominio propio y preferís el paso manual (DNS + SSL "Flexible"),
# dejá las tres variables CF_* vacías: el script solo va a imprimir las
# instrucciones usando este dominio.
DOMINIO=                           # ej. carta.midominio.cl (vacío = usar el Worker *.workers.dev)

# Completá estas tres para que "cloudflare" automatice todo por API (crea el
# KV de rate-limit, publica el Worker y activa el subdominio) sin tocar el
# dashboard. Se generan gratis, sin dominio propio — ver docs/despliegue-automatico.md.
CF_API_TOKEN=                      # dash.cloudflare.com → perfil → API Tokens → "Edit Cloudflare Workers"
CF_ACCOUNT_ID=                     # dash.cloudflare.com → Workers & Pages → barra lateral derecha
CF_SUBDOMAIN=                      # tu prefijo *.workers.dev, SIN ".workers.dev" (ej. carlos0tapi)
CF_WORKER_NAME=                    # opcional; vacío = ${NAME_PREFIX}-proxy
