# Configuración para scripts/jenkins/desplegar-jenkins.sh
# Copiá este archivo a jenkins.env (NO se sube al repo) y completá los valores.
#
#   cp scripts/jenkins/jenkins.env.example scripts/jenkins/jenkins.env

AWS_REGION=us-east-1

# Tu propia IP pública, para que SOLO vos (y quien más agregues) pueda
# entrar al panel de Jenkins (puerto 8080). Buscá "cual es mi ip" en Google
# y agregale /32 al final. Ejemplo: 190.12.34.56/32
MI_IP=

# Opcional: nombre de un Key Pair de EC2 ya existente, por si querés poder
# entrar por SSH a la instancia además del panel web.
KEY_NAME=

# Tamaño de la instancia. t3.small anda bien para Jenkins + Docker con
# containers livianos (node:20-alpine, postgres:17-alpine); si el laboratorio
# no te deja usar t3.small, probá con t3.micro (puede ir más lento).
INSTANCE_TYPE=t3.small
